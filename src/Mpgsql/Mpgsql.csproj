<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Mpgsql</RootNamespace>
        <AssemblyName>Mpgsql</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackageId>Mpgsql</PackageId>
        <Version>0.1.0-alpha.1</Version>
        <Title>Mpgsql: Minimalistic PostgreSQL driver</Title>
        <Description>Asynchronous ADO.NET provider for PostgreSQL with native TCP/TLS authentication, an exclusive connection pool, typed parameters and readers, reusable commands and batches, local transactions, and prepared statements.</Description>
        <Authors>Belov Ilya and contributors</Authors>
        <PackageTags>postgresql;postgres;ado.net;database;driver;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>mpgsql-icon.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Gagarin23/mpgsql</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Gagarin23/mpgsql</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSessionBuildOutput</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>
    <ItemGroup>
        <!-- Sessions ships inside this package; only Protocol is a NuGet dependency. -->
        <ProjectReference Include="../Mpgsql.Sessions/Mpgsql.Sessions.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../Mpgsql.Protocol/Mpgsql.Protocol.csproj" />
        <InternalsVisibleTo Include="Mpgsql.Tests"/>
        <InternalsVisibleTo Include="Mpgsql.Benchmarks"/>
        <InternalsVisibleTo Include="Mpgsql.IntegrationTests"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="/"/>
        <None Include="../../assets/branding/mpgsql-icon.png" Pack="true" PackagePath="/"/>
    </ItemGroup>
    <Target Name="IncludeSessionBuildOutput">
        <ItemGroup>
            <BuildOutputInPackage Include="$(TargetDir)Mpgsql.Sessions.dll"/>
            <BuildOutputInPackage Include="$(TargetDir)Mpgsql.Sessions.xml" Condition="Exists('$(TargetDir)Mpgsql.Sessions.xml')"/>
        </ItemGroup>
    </Target>
</Project>
