<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Mpgsql.Protocol</PackageId>
        <AssemblyName>Mpgsql.Protocol</AssemblyName>
        <Version>0.1.0-alpha.2</Version>
        <Title>Mpgsql.Protocol: Minimalistic PostgreSQL protocol and binary converters for manual use</Title>
        <Description>Minimalistic standalone PostgreSQL protocol 3.0 message codecs, binary type converters, PostgreSQL value types, and binary COPY primitives for .NET.</Description>
        <Authors>Belov Ilya and contributors</Authors>
        <PackageTags>postgresql;postgres;protocol;binary;copy;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>mpgsql-icon.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Gagarin23/mpgsql</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Gagarin23/mpgsql</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <RootNamespace>Mpgsql</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The provider and sessions reuse wire/codec internals without widening the public API. -->
        <InternalsVisibleTo Include="Mpgsql"/>
        <InternalsVisibleTo Include="Mpgsql.Sessions"/>
        <InternalsVisibleTo Include="Mpgsql.Tests"/>
        <InternalsVisibleTo Include="Mpgsql.Benchmarks"/>
        <InternalsVisibleTo Include="Mpgsql.IntegrationTests"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="/"/>
        <None Include="../../assets/branding/mpgsql-icon.png" Pack="true" PackagePath="/"/>
        <None Remove="Converters\NumericCodec.Simd.cs~"/>
    </ItemGroup>

</Project>
