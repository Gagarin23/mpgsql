<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Mpgsql</RootNamespace>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Mpgsql.Protocol\Mpgsql.Protocol.csproj" />
        <InternalsVisibleTo Include="Mpgsql"/>
        <InternalsVisibleTo Include="Mpgsql.Multiplexing"/>
        <InternalsVisibleTo Include="Mpgsql.Tests"/>
        <InternalsVisibleTo Include="Mpgsql.Benchmarks"/>
        <InternalsVisibleTo Include="Mpgsql.IntegrationTests"/>
    </ItemGroup>
    <ItemGroup>
        <None Remove="Internal\MessageOperationKind.cs~"/>
    </ItemGroup>
</Project>
